# Copy to .env. The default setup (config.yaml) runs fully local and needs nothing here.
# Keys are read from the environment only; never put one in config.yaml.

# Only if you point an llm_server in config.yaml at a hosted API (its api_key_env names the variable):
# DEEPINFRA_API_KEY=

# Only for voice: Sarvam speech-to-text and text-to-speech, used by the Bolna server.
# SARVAM_API_KEY=
