{
  "agent_config": {
    "agent_name": "Kisht demo-nbfc -> br_0009 (mic)",
    "agent_type": "other",
    "tasks": [
      {
        "task_type": "conversation",
        "toolchain": {
          "execution": "parallel",
          "pipelines": [
            [
              "transcriber",
              "llm",
              "synthesizer"
            ]
          ]
        },
        "tools_config": {
          "input": {
            "provider": "default",
            "format": "pcm"
          },
          "output": {
            "provider": "default",
            "format": "pcm"
          },
          "transcriber": {
            "provider": "sarvam",
            "model": "saarika:v2.5",
            "language": "en-IN",
            "stream": true,
            "encoding": "linear16",
            "endpointing": 400,
            "high_vad_sensitivity": false
          },
          "llm_agent": {
            "agent_type": "simple_llm_agent",
            "agent_flow_type": "streaming",
            "llm_config": {
              "provider": "custom",
              "model": "demo-nbfc:br_0009",
              "base_url": "http://localhost:5050/v1",
              "max_tokens": 400,
              "temperature": 0.3
            }
          },
          "synthesizer": {
            "provider": "sarvam",
            "stream": true,
            "audio_format": "linear16",
            "provider_config": {
              "voice": "shreya",
              "voice_id": "shreya",
              "model": "bulbul:v3",
              "language": "hi-IN"
            },
            "buffer_size": 40.0,
            "caching": true
          }
        },
        "task_config": {
          "hangup_after_silence": 30.0,
          "use_fillers": false,
          "optimize_latency": false,
          "number_of_words_for_interruption": 2,
          "backchanneling": false,
          "incremental_delay": 1500,
          "check_if_user_online": false
        }
      }
    ],
    "agent_welcome_message": "Namaste, main Asha bol rahi hoon Demo Finance se. Kya meri baat Priya ji se ho rahi hai?"
  },
  "agent_prompts": {
    "task_1": {
      "system_prompt": "Unused: every reply comes from the Kisht agent behind the custom LLM endpoint."
    }
  }
}